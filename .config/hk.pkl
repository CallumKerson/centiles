amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

min_hk_version = "2.6.0"

// mise lock writes .config/mise/locks. rust-anything writes the recorded cases, reference
// data and its own state under rust/; formatting them would change what they record.
exclude =
  List(
    ".config/mise/locks/**",
    "CHANGELOG.md",
    "LICENSE",
    "rust/app-cases/**",
    "rust/**/rust-anything.json",
    "rust/centiles-rs/recorded-from.json",
  )

local linters = new Mapping<String, Step> {
  ["byte_order_marker"] = Builtins.byte_order_marker
  // Builtins.check_added_large_files, skipping files Git LFS stores, as pre-commit's check does.
  ["check_added_large_files"] = new Step {
    check =
      #"git check-attr -z filter -- {{files}} | xargs -0 -n3 sh -c '[ "$2" = lfs ] || printf "%s\0" "$0"' | xargs -0 -r hk util check-added-large-files"#
  }
  ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_symlinks"] = Builtins.check_symlinks
  ["detect_private_key"] = Builtins.detect_private_key
  ["fix_smart_quotes"] = Builtins.fix_smart_quotes
  ["jactionlint"] = Builtins.jactionlint
  // Other file types have their own linters
  ["json"] = (Builtins.oxfmt) {
    glob = List("**/*.json", "**/*.jsonc")
  }
  ["mixed_line_ending"] = Builtins.mixed_line_ending
  ["newlines"] = Builtins.newlines
  ["pkl"] = Builtins.pkl
  ["pkl_format"] = Builtins.pkl_format
  ["python_check_ast"] = Builtins.python_check_ast
  ["python_debug_statements"] = Builtins.python_debug_statements
  ["ruff"] = Builtins.ruff
  ["ruff_format"] = Builtins.ruff_format
  ["rumdl"] = Builtins.rumdl
  ["toml"] = Builtins.tombi
  ["toml_format"] = Builtins.tombi_format
  ["trailing_whitespace"] = Builtins.trailing_whitespace
  ["ty"] = Builtins.ty
  ["typos"] = Builtins.typos
  ["yaml"] = Builtins.ryl
}

local commit_message_check = new Mapping<String, Step> {
  ["check_conventional_commit"] = Builtins.check_conventional_commit
  ["typos"] {
    check = "typos {{commit_msg_file}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["commit-msg"] {
    steps = commit_message_check
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
